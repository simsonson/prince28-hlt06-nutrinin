APP_NAME=nutrinin
APP_ENV=local
LOG_LEVEL=INFO
DATA_FILE=data/sample_records.json

DATABASE_URL=postgresql://localhost:5432/nutrinin

# Optional Cloudflare R2 S3-compatible storage for data/raw/ (never commit real values)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
