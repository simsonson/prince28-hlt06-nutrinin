APP_NAME=nutrinin
APP_ENV=local
LOG_LEVEL=INFO
DATA_FILE=data/sample_records.json

DATABASE_URL=postgresql://localhost:5432/nutrinin

# Optional Supabase Storage S3-compatible upload for data/raw/ (never commit real values)
SUPABASE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-south-1
SUPABASE_STORAGE_BUCKET=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
