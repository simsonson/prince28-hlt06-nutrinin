APP_NAME=nutrinin
APP_ENV=local
LOG_LEVEL=INFO
DATA_FILE=data/sample_records.json

DATABASE_URL=postgresql://localhost:5432/nutrinin

# Optional Supabase Storage S3-compatible upload for data/raw/ (never commit real values)
SUPABASE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-south-1
SUPABASE_STORAGE_BUCKET=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# LLM keys (Day 8). Free keys: https://aistudio.google.com/apikey and https://console.groq.com/keys
# Real values go in .env, GitHub Secrets and Render only. Never in Git.
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PRIMARY_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# Queue and worker (Day 10). On your laptop Redis comes from: docker compose up -d redis
REDIS_URL=redis://localhost:6379
# Whoever sends this value in the X-Admin-Token header may start an ingestion. Long and random.
ADMIN_TOKEN=
# true only where there is no separate worker service (Render free): the API runs the worker.
WORKER_IN_API=false
